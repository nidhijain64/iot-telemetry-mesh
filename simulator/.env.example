AUTH_URL=http://localhost:3001
DEVICE_REGISTRY_URL=http://localhost:3002
MQTT_WS_URL=ws://localhost:3003

# An account you registered via POST /api/auth/register. The simulator logs in
# as this user, so its devices show up on that user's dashboard and nobody
# else's.
SIM_USERNAME=
SIM_PASSWORD=

PUBLISH_INTERVAL_MS=5000
FLEET_SIZE=3
