# The API gateway — one origin for every REST call.
VITE_API_URL=http://localhost:3005

# MQTT over WebSockets, straight to data-ingestion-service (not the gateway).
VITE_MQTT_WS_URL=ws://localhost:3003

# ---- Optional: HTTPS dev server ----
# Only needed to open the /mobile-node page on a real phone — browsers gate
# microphone and motion sensors behind a secure context.
SSL_KEY_PATH=
SSL_CERT_PATH=

# ---- Optional: public demo access ----
# Set both to show a "Sign in as demo" panel on the login page, so anyone with
# the link can look around without an account. Leave blank in any deployment
# where you don't want that. The account is an ordinary operator — registration
# never grants admin, so a visitor only ever sees that account's own devices.
VITE_DEMO_USERNAME=
VITE_DEMO_PASSWORD=
