# The API gateway — one origin for every REST call.
VITE_API_URL=http://localhost:3005

# MQTT over WebSockets, straight to data-ingestion-service (not the gateway).
VITE_MQTT_WS_URL=ws://localhost:3003

# ---- Optional: HTTPS dev server ----
# Only needed to open the /mobile-node page on a real phone — browsers gate
# microphone and motion sensors behind a secure context.
SSL_KEY_PATH=
SSL_CERT_PATH=
