PORT=3001

# Any MongoDB connection string (Atlas or local).
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/iot_auth

# ---- Shared across ALL services — these MUST be byte-identical everywhere ----
# Every service verifies JWTs locally with this secret instead of calling back
# to auth-service, so a mismatch shows up as "Invalid token" on a valid login.
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-me-with-openssl-rand-hex-32

# How long a login stays valid. Any ms/vercel-style duration string.
JWT_EXPIRY=1h

# ---- CORS ----
# Comma-separated list of origins allowed to call this API from a browser, e.g.
# "http://localhost:5173" in dev, your dashboard's real URL in production.
# Left blank, every origin is allowed — fine locally, a hole once deployed.
CORS_ORIGIN=

# ---- Login brute-force protection ----
# Counts only FAILED attempts per client IP, so logging in from many devices is
# fine but repeated wrong passwords are throttled.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_MAX=5

# ---- Optional: HTTPS ----
# Leave both blank for plain HTTP on localhost. Set them (e.g. to mkcert output)
# only when a real phone on your network needs to reach this service — browsers
# refuse to hand out microphone/motion sensors over plain HTTP.
SSL_KEY_PATH=
SSL_CERT_PATH=
