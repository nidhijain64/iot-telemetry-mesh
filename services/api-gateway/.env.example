# Single public entry point — the dashboard only ever talks to this port.
# Note it proxies HTTP only; MQTT-over-WebSocket connects straight to
# data-ingestion-service, since that upgrade doesn't pass through the proxy.
PORT=3005

# Use http://<service-name>:<port> under Docker Compose, localhost otherwise.
AUTH_URL=http://localhost:3001
DEVICE_REGISTRY_URL=http://localhost:3002
INGESTION_URL=http://localhost:3003
ALERT_URL=http://localhost:3004

# ---- CORS ----
# Comma-separated list of origins allowed to call this API from a browser, e.g.
# "http://localhost:5173" in dev, your dashboard's real URL in production.
# Left blank, every origin is allowed — fine locally, a hole once deployed.
CORS_ORIGIN=

# How long to wait for an upstream service. Free hosting suspends idle services,
# and a cold start takes ~30-60s — shorter than this and the first request after
# a quiet period fails while the service is still coming up.
UPSTREAM_TIMEOUT_MS=90000

SSL_KEY_PATH=
SSL_CERT_PATH=
