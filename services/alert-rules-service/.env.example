PORT=3004

MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/iot_alerts

# ---- Shared across ALL services — these MUST be byte-identical everywhere ----
# Every service verifies JWTs locally with this secret instead of calling back
# to auth-service, so a mismatch shows up as "Invalid token" on a valid login.
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-me-with-openssl-rand-hex-32

INTERNAL_SERVICE_KEY=replace-me-with-openssl-rand-hex-32

DEVICE_REGISTRY_URL=http://localhost:3002

# ---- Static thresholds ----
TEMP_THRESHOLD_C=35
BATTERY_THRESHOLD_PCT=20

# Once an alert type fires for a device, the same type stays quiet this long.
ALERT_COOLDOWN_MS=300000

# ---- Rolling z-score detector (sound only) ----
# Flags a reading more than N standard deviations above that device's own
# recent baseline, computed over the last WINDOW readings.
SOUND_BASELINE_WINDOW=20
SOUND_Z_SCORE_THRESHOLD=2.5

# ---- Optional: outbound notifications ----
# Slack-shaped incoming webhook. Left blank, critical alerts are logged instead.
ALERT_WEBHOOK_URL=

# ---- CORS ----
# Comma-separated list of origins allowed to call this API from a browser, e.g.
# "http://localhost:5173" in dev, your dashboard's real URL in production.
# Left blank, every origin is allowed — fine locally, a hole once deployed.
CORS_ORIGIN=

SSL_KEY_PATH=
SSL_CERT_PATH=
