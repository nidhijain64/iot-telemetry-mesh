# Serves BOTH the REST API and the MQTT-over-WebSocket broker on this one port.
PORT=3003

MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/iot_telemetry

# ---- Shared across ALL services — these MUST be byte-identical everywhere ----
# Every service verifies JWTs locally with this secret instead of calling back
# to auth-service, so a mismatch shows up as "Invalid token" on a valid login.
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-me-with-openssl-rand-hex-32

INTERNAL_SERVICE_KEY=replace-me-with-openssl-rand-hex-32

# Use http://<service-name>:<port> under Docker Compose, localhost otherwise.
DEVICE_REGISTRY_URL=http://localhost:3002
ALERT_SERVICE_URL=http://localhost:3004

# Readings kept in memory per device for the live view. History is read from
# MongoDB instead, so this only bounds the "right now" window.
RING_BUFFER_SIZE=50

# How often a connected dashboard re-checks which devices it may see, so a
# newly registered device starts streaming without a page reload.
VIEWER_SCOPE_REFRESH_MS=30000

# How often a publishing device is reported alive to device-registry. Keep it
# well below that service's STALE_AFTER_MS (default 120000) or devices will
# flicker offline between reports while they are publishing normally.
LIVENESS_THROTTLE_MS=30000

# ---- CORS ----
# Comma-separated list of origins allowed to call this API from a browser, e.g.
# "http://localhost:5173" in dev, your dashboard's real URL in production.
# Left blank, every origin is allowed — fine locally, a hole once deployed.
CORS_ORIGIN=

SSL_KEY_PATH=
SSL_CERT_PATH=
