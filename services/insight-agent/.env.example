PORT=3006

MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/iot_insights

# Byte-identical to every other service — tokens are verified locally.
JWT_SECRET=replace-me-with-openssl-rand-hex-32
# Byte-identical to device-registry, data-ingestion and alert-rules.
INTERNAL_SERVICE_KEY=replace-me-with-openssl-rand-hex-32

# Free tier at https://console.groq.com — the agent refuses to start without it.
GROQ_API_KEY=

# Only the gpt-oss and qwen families enforce a JSON schema (strict mode) on
# Groq. llama-3.3-70b-versatile works too but returns best-effort JSON, which
# this service re-validates and discards on mismatch.
GROQ_MODEL=openai/gpt-oss-120b

DEVICE_REGISTRY_URL=http://localhost:3002
ALERT_SERVICE_URL=http://localhost:3004

# ---- Agent behaviour ----
# How often to look for clusters worth explaining.
INSIGHT_POLL_INTERVAL_MS=60000
# How far back a cluster may reach.
INSIGHT_WINDOW_MS=900000
# Below this many alerts for one device, there is nothing to explain that the
# alert itself does not already say.
INSIGHT_MIN_ALERTS=3
# Never re-explain the same device more often than this, however noisy it gets.
INSIGHT_COOLDOWN_MS=1800000

# ---- Optional: outbound proxy ----
# groq-sdk uses node-fetch, which ignores HTTP_PROXY/HTTPS_PROXY on its own. If
# either is set in the environment the agent picks it up and routes model calls
# through it; on a normal network leave them unset.

CORS_ORIGIN=
NODE_ENV=production
